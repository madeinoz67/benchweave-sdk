{
  "otdp_version": "{{ otdp_version }}",
  "descriptor_version": "0.1.0",
  "id": "dev.example.{{ package_name | replace('_', '-') }}",
  "display_name": "SDK synthetic example",
  "description": "Simulated read-only protocol; not hardware qualified.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "SDK Example",
    "model": "demo",
    "firmware_policy": "listed",
    "supported_firmware": [
      "1.0.0"
    ]
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "{{ package_name }}.adapter:create_plugin",
      "api_version": "1.1",
      "version": "0.1.0",
      "dependencies": [],
      "permissions": [
        "scoped_transport"
      ]
    }
  },
{%- if provider_transport %}
  "transport": {
    "type": "custom",
    "connection_key": "example_device",
    "settings": {
      "protocol_reference": "Synthetic FTDI common control bring-up; the grammar is the pinned provider contract"
    },
    "provider": {
      "feature_id": "otdp.transport.ftdi-control/1.1.0",
      "id": "urn:otdp:transport-provider:ftdi-control:1.1.0",
      "path": "ftdi-control-provider.json",
      "sha256": "b4b5a8ccad6d11a15f9383649a619d152423f873a01420ff0da30258b8a73f13"
    }
  },
{%- else %}
  "transport": {
    "type": "serial",
    "connection_key": "example_device",
    "settings": {
      "baud": 115200,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "rtscts": false,
      "max_frame_bytes": 128
    }
  },
{%- endif %}
  "capabilities": [
    "identify",
    "read"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 1000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 1000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    }
  },
{%- if provider_transport %}
  "parameters": [
    {
      "name": "line_status",
      "description": "Line status byte reported by the control surface",
      "type": "int",
      "access": "ro",
      "semantic": "measurement",
      "unit": "count",
      "binding": {
        "kind": "adapter",
        "key": "line_status"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    }
  ],
{%- else %}
  "parameters": [
    {
      "name": "voltage",
      "description": "Synthetic voltage",
      "type": "float",
      "access": "ro",
      "semantic": "measurement",
      "unit": "V",
      "binding": {
        "kind": "adapter",
        "key": "voltage"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    }
  ],
{%- endif %}
  "required_features": [
    "otdp.core/0.1.0",
    "otdp.adapter/0.1.0"{% if provider_transport %},
    "otdp.transport.ftdi-control/1.1.0"{% endif %}
  ],
  "provenance": {
    "sources": [
      {
        "title": "SDK synthetic protocol",
        "reference": "protocol.md",
        "revision": "0.1.0"
      }
    ],
{%- if provider_transport %}
    "test_vectors": [
      {
        "id": "bring-up-rehearsal",
        "path": "ftdi-control-provider.json",
        "purpose": "Rehearsal scripts speak the pinned contract's grammar; record a journal on the bench with --record"
      }
    ]
{%- else %}
    "test_vectors": [
      {
        "id": "example",
        "path": "vectors.json",
        "purpose": "Synthetic identify/read exchanges"
      }
    ]
{%- endif %}
  }
}
