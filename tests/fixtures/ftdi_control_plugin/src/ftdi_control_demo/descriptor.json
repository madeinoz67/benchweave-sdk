{
  "otdp_version": "0.2.4",
  "descriptor_version": "1.0.0",
  "id": "dev.local.ftdi-control-demo",
  "display_name": "FTDI control fixture demo",
  "description": "Synthetic FTDI-control provider plugin for the live provider transport suite; not hardware qualified.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "OTDP Reference",
    "model": "ftdi-control-demo",
    "firmware_policy": "listed",
    "supported_firmware": [
      "1.0"
    ]
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "ftdi_control_demo.adapter:create_plugin",
      "api_version": "1.1",
      "version": "0.1.0",
      "dependencies": [],
      "permissions": [
        "scoped_transport"
      ]
    }
  },
  "transport": {
    "type": "custom",
    "connection_key": "ftdi_demo",
    "settings": {
      "protocol_reference": "Synthetic FTDI control bring-up; the grammar is the pinned provider contract"
    },
    "provider": {
      "feature_id": "otdp.transport.ftdi-control/1.0.0",
      "id": "urn:otdp:transport-provider:ftdi-control:1.0.0",
      "path": "ftdi-control-provider.json",
      "sha256": "762c7397eeabfb65830948de848a1cf7c0867583f11cc289f25c6be3acf97e92"
    }
  },
  "capabilities": [
    "identify",
    "read"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "line_status",
      "description": "Line status reported by the pinned control surface",
      "type": "int",
      "access": "ro",
      "semantic": "measurement",
      "binding": {
        "kind": "adapter",
        "key": "line_status"
      },
      "unit": "count",
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    }
  ],
  "required_features": [
    "otdp.core/0.1.0",
    "otdp.adapter/0.1.0",
    "otdp.transport.ftdi-control/1.0.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "FTDI common control surface contract",
        "reference": "ftdi-control-provider.json",
        "revision": "1.0.0"
      }
    ],
    "test_vectors": [
      {
        "id": "bring-up-journal",
        "path": "bring-up-journal.json",
        "purpose": "The bring-up journal, spelled independently of the builders; the pinned contract is the grammar both speak"
      }
    ]
  }
}
