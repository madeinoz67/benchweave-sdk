{
  "otdp_version": "0.2.3",
  "descriptor_version": "1.0.0",
  "id": "dev.veridian.dmm",
  "display_name": "Veridian DMM-01 class fixture",
  "description": "Class-contract fixture, not a verified real device or implemented adapter.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "Veridian Instruments",
    "model": "DMM-01",
    "firmware_policy": "listed",
    "supported_firmware": [
      "1.0"
    ]
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "veridian_classref_plugin.readings_adapter:create_plugin",
      "api_version": "1.1",
      "version": "1.0.0",
      "dependencies": [],
      "permissions": [
        "scoped_transport",
        "artifact_writer"
      ]
    }
  },
  "transport": {
    "type": "serial",
    "connection_key": "capture_device",
    "settings": {
      "baud": 115200,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "rtscts": false,
      "max_frame_bytes": 65536
    }
  },
  "capabilities": [
    "identify",
    "invoke",
    "read"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "invoke": {
      "timeout_ms": 30000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "ch1_voltage",
      "description": "Synthetic voltage reading for ch1",
      "type": "float",
      "access": "ro",
      "semantic": "measurement",
      "unit": "V",
      "binding": {
        "kind": "adapter",
        "key": "ch1_voltage"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "ch2_voltage",
      "description": "Synthetic voltage reading for ch2",
      "type": "float",
      "access": "ro",
      "semantic": "measurement",
      "unit": "V",
      "binding": {
        "kind": "adapter",
        "key": "ch2_voltage"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    }
  ],
  "required_features": [
    "otdp.core/0.1.0",
    "otdp.adapter/0.1.0",
    "otdp.profile_actions/0.1.0",
    "otdp.measurement/0.1.0",
    "otdp.dmm/1.0.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "OTDP class contracts (structural fixture only)",
        "reference": "../device-classes.md",
        "revision": "1.0.0"
      }
    ],
    "test_vectors": [
      {
        "id": "dmm-actions",
        "path": "class-action-vectors.json",
        "purpose": "Input/output contract examples; not a device simulator"
      }
    ]
  },
  "channels": [
    {
      "id": "ch1",
      "label": "Reference channel 1",
      "role": "measure",
      "quantities": [
        "voltage"
      ],
      "parameter_names": [
        "ch1_voltage"
      ]
    },
    {
      "id": "ch2",
      "label": "Reference channel 2",
      "role": "measure",
      "quantities": [
        "voltage"
      ],
      "parameter_names": [
        "ch2_voltage"
      ]
    }
  ],
  "profiles": [
    "otdp.dmm/1.0.0"
  ],
  "contracts": [
    {
      "id": "urn:otdp:profile-catalog:0.2.3",
      "path": "device-profile-catalog.json",
      "sha256": "0bb1747fe84f047dbd34e77fb6f848bc8554b0fd1776e8988c79f8185e1273a4"
    },
    {
      "id": "urn:otdp:measurement:0.2.3",
      "path": "otdp-measurement.schema.json",
      "sha256": "383fedc9af7515c17325d2abe938d3a60e23a2460a7153a710bba7fe41cf574b"
    }
  ],
  "actions": {
    "otdp.dmm.configure/1.0.0": {
      "binding": {
        "kind": "adapter",
        "key": "otdp.dmm.configure/1.0.0"
      },
      "input_constraints": {},
      "timeout_ms": 30000,
      "side_effect": "state_change",
      "cancellable": true,
      "retry": "never"
    },
    "otdp.dmm.measure/1.0.0": {
      "binding": {
        "kind": "adapter",
        "key": "otdp.dmm.measure/1.0.0"
      },
      "input_constraints": {},
      "timeout_ms": 30000,
      "side_effect": "none",
      "cancellable": true,
      "retry": "never"
    }
  }
}
