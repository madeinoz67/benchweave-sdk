{
  "otdp_version": "0.2.4",
  "descriptor_version": "0.1.0",
  "id": "dev.example.example-plugin",
  "display_name": "SDK synthetic example",
  "description": "Simulated read-only protocol; not hardware qualified.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "SDK Example",
    "model": "demo",
    "firmware_policy": "listed",
    "supported_firmware": [
      "1.0.0"
    ]
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "example_plugin.adapter:create_plugin",
      "api_version": "1.1",
      "version": "0.1.0",
      "dependencies": [],
      "permissions": [
        "scoped_transport"
      ]
    }
  },
  "transport": {
    "type": "custom",
    "connection_key": "example_device",
    "settings": {
      "protocol_reference": "Synthetic FTDI common control bring-up; the grammar is the pinned provider contract"
    },
    "provider": {
      "feature_id": "otdp.transport.ftdi-control/1.1.0",
      "id": "urn:otdp:transport-provider:ftdi-control:1.1.0",
      "path": "ftdi-control-provider.json",
      "sha256": "b4b5a8ccad6d11a15f9383649a619d152423f873a01420ff0da30258b8a73f13"
    }
  },
  "capabilities": [
    "identify",
    "read"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 1000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 1000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "line_status",
      "description": "Line status byte reported by the control surface",
      "type": "int",
      "access": "ro",
      "semantic": "measurement",
      "unit": "count",
      "binding": {
        "kind": "adapter",
        "key": "line_status"
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    }
  ],
  "required_features": [
    "otdp.core/0.1.0",
    "otdp.adapter/0.1.0",
    "otdp.transport.ftdi-control/1.1.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "SDK synthetic protocol",
        "reference": "protocol.md",
        "revision": "0.1.0"
      }
    ],
    "test_vectors": [
      {
        "id": "bring-up-rehearsal",
        "path": "ftdi-control-provider.json",
        "purpose": "Rehearsal scripts speak the pinned contract's grammar; record a journal on the bench with --record"
      }
    ]
  }
}
