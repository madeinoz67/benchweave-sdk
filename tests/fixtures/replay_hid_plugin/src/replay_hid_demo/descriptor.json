{
  "otdp_version": "0.2.4",
  "descriptor_version": "1.0.0",
  "id": "dev.local.replay-hid-demo",
  "display_name": "Replay fixture hid demo",
  "description": "Synthetic provider-declaring plugin for the replay transport suite; not hardware qualified.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "OTDP Reference",
    "model": "replay-hid-demo",
    "firmware_policy": "listed",
    "supported_firmware": [
      "1.0"
    ]
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "replay_hid_demo.adapter:create_plugin",
      "api_version": "1.1",
      "version": "0.1.0",
      "dependencies": [],
      "permissions": [
        "scoped_transport"
      ]
    }
  },
  "transport": {
    "type": "custom",
    "connection_key": "hid_demo",
    "settings": {
      "protocol_reference": "Synthetic HID report protocol; the grammar is the pinned provider contract"
    },
    "provider": {
      "feature_id": "otdp.transport.reference-hid/1.0.0",
      "id": "urn:otdp:transport-provider:reference-hid:1.0.0",
      "path": "reference-provider.json",
      "sha256": "cf50392a5d9f996ebe40796800b3ee84ce72b420594acc902fed893efbf3cc47"
    }
  },
  "capabilities": [
    "identify",
    "read",
    "capture"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "capture": {
      "timeout_ms": 5000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    }
  },
  "capture_formats": [
    "raw_binary"
  ],
  "capture_limits": {
    "max_samples": 100000,
    "max_bytes": 16777216
  },
  "parameters": [
    {
      "name": "bus_power",
      "description": "Bus power reported by the metered load",
      "type": "float",
      "access": "ro",
      "semantic": "measurement",
      "binding": {
        "kind": "adapter",
        "key": "bus_power_w"
      },
      "unit": "W",
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    }
  ],
  "required_features": [
    "otdp.core/0.1.0",
    "otdp.adapter/0.1.0",
    "otdp.transport.reference-hid/1.0.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "OTDP reference transport-provider contract",
        "reference": "reference-provider.json",
        "revision": "1.0.0"
      }
    ],
    "test_vectors": [
      {
        "id": "replay-journals",
        "path": "reference-provider.json",
        "purpose": "The replay journals live in the SDK suite, spelled independently of this package's builders; the pinned contract is the grammar both speak"
      }
    ]
  }
}
