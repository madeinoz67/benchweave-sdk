__pycache__/
venv/

# Codanna code index — .codanna/settings.toml is committed, the built index is not.
# The model cache is a symlink into the user's Codanna models directory, so the bare
# name is required (a trailing slash matches directories only, and git would then see
# the symlink as an untracked pointer into a home directory).
.codanna/index/
.codanna/.project-id
.fastembed_cache
.claude/worktrees/
docs/superpowers/

# Memory-proposal ledger: session findings queued for the vault (see .claude/memory-protocol.md)
.claude/memory-proposals.jsonl
.claude/memory-proposals.jsonl.tmp
.claude/memory-proposals.drained.jsonl
.claude/memory-proposals.deadletter.jsonl
.claude/memory-proposals.lock
.claude/memory-drain-receipt.json
.claude/memory-drain-receipt.json.tmp
.claude/memory-drain-receipts.jsonl
.claude/memory-drain-receipts.jsonl.tmp
.claude/settings.local.json

# Generated documentation artifacts (still local-only, never hand-edited).
wiki/
docs/architecture/
CHANGELOG_AUTO.md

# Great Docs build output — ephemeral, regenerated by `great-docs build`
great-docs/
_great_docs_build/
.great-docs/
.great-docs-cache/

# Assembled versioned docs site + isolated-build staging — regenerated by
# scripts/assemble_docs_site.py (never commit build output). Anchored to the
# repo root: an unanchored `site/` can match nested build output the same
# way it once matched the deleted SDK renderer bundle's site tree during
# packaging, silently dropping it from sdists.
/site/
/.docs-assembly/

# Design records: private/ holds pre-promotion designs (see .claude/deep-review/README.md)
.claude/deep-review/private/

# In-flight standards sync: the new tree is staged here and the old one parked
# during the swap (standards_sync._staging_paths). Outside src/ on purpose, so
# a crash can never leave debris where packaging looks; swept by the next sync.
/.standards-sync/

# slice-B gate scratch (B-U fresh-venv run, build outputs)
.bu-venv/
.bu-scratch/
dist/

# Claim lane run output — trace artifacts and the shadow report, never
# committed (scripts/claim_lane.py writes here; AR-7's key-leak grep runs
# over this tree)
.claim-lane/

# Verification-skill proof artifacts (`.claude/skills/verify-benchweave-sdk/`) — transcripts,
# exit codes and captured streams from a real CLI drive. Evidence, never committed.
.verify/

# parallel-lane worktrees (2026-09-28 owner directive; gateway repo convention)
.wt/
