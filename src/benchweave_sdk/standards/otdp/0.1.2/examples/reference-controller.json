{
  "otdp_version": "0.1.2",
  "descriptor_version": "1.0.0",
  "id": "dev.local.reference-controller",
  "display_name": "Illustrative reference-controller",
  "description": "Reference protocol only; not a qualified commercial instrument or bench safety profile.",
  "identity": {
    "strategy": "uart_identity",
    "manufacturer": "OTDP Reference",
    "model": "reference-controller",
    "firmware_policy": "listed",
    "supported_firmware": [
      "1.0"
    ]
  },
  "integration": {
    "mode": "declarative"
  },
  "transport": {
    "type": "uart_json",
    "connection_key": "controller",
    "settings": {
      "baud": 115200,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "rtscts": false,
      "max_frame_bytes": 4096,
      "framing": "ndjson"
    }
  },
  "capabilities": [
    "identify",
    "read",
    "write",
    "self_test",
    "stream_subscribe",
    "stream_unsubscribe"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "write": {
      "timeout_ms": 2000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "self_test": {
      "timeout_ms": 2000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "stream_subscribe": {
      "timeout_ms": 2000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "stream_unsubscribe": {
      "timeout_ms": 2000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "battery_voltage",
      "description": "battery voltage",
      "type": "float",
      "access": "ro",
      "semantic": "measurement",
      "binding": {
        "kind": "uart_json"
      },
      "unit": "V",
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "led_state",
      "description": "led state",
      "type": "enum",
      "access": "rw",
      "semantic": "configuration",
      "binding": {
        "kind": "uart_json"
      },
      "enum_values": [
        "off",
        "red",
        "green",
        "blue"
      ],
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      },
      "hazard_class": "unknown",
      "write_policy": {
        "effect": "setting",
        "completion": "acknowledged",
        "retry": "never"
      }
    }
  ],
  "required_features": [
    "otdp.core/0.1.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "OTDP reference protocol",
        "reference": "reference-protocols.md",
        "revision": "0.1.0"
      }
    ],
    "test_vectors": [
      {
        "id": "reference-controller-reference",
        "path": "reference-vectors.json",
        "purpose": "Normative reference exchanges and codec outcomes"
      }
    ]
  },
  "stream_limits": {
    "min_interval_ms": 100,
    "max_subscriptions": 1
  }
}
