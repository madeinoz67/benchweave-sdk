{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^urn:otdp:transport-provider:[a-z][a-z0-9-]*:[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^otdp\\.transport\\.[a-z][a-z0-9-]*/[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "The feature this contract registers on admission. Provider features live under otdp.transport. only — the otdp.* namespace is corpus-owned (extension-contract section 1) and a contract claiming any other reserved id is refused here, before any host could mint it. The version is three components, the same strict shape the version field carries, so the embedded-version identity equality can hold."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "transport_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "transaction_grammar": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "request_schema": {
            "type": "object"
          },
          "result_schema": {
            "type": "object"
          },
          "limits": {
            "type": "object"
          }
        },
        "required": [
          "kind",
          "request_schema",
          "result_schema",
          "limits"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "security_scope": {
      "enum": [
        "commissioned_connection"
      ]
    },
    "host_requirements": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "native_libraries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "privileges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "enum": [
                  "identity",
                  "protocol",
                  "envelope",
                  "protection",
                  "timing",
                  "safe_transition",
                  "audit_failure",
                  "unattended"
                ]
              },
              "report": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "version",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "tested_at": {
                "type": "string",
                "format": "date-time"
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "partial"
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "category",
              "report",
              "tested_at",
              "scope",
              "result",
              "limitations"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "approved_by",
        "approved_at",
        "expires_at",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "id",
    "feature_id",
    "version",
    "description",
    "transport_kind",
    "transaction_grammar",
    "security_scope",
    "host_requirements",
    "approval"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:otdp:transport-provider-contract:0.2.2",
  "title": "OTDP 0.2.2 transport-provider contract — STG architecture contract",
  "description": "Structure only. A transport-provider contract is a host-admitted document in the commissioning evidence shape; JSON validity grants no authority. The host validates provider transactions against the admitted contract's grammar, never against the generic table. The schema's closed boundary is security_scope alone — a closed enum admitting only commissioned_connection, in which a filesystem path, process spawning or an unrestricted network endpoint is unrepresentable. The document's remaining fields describe and do not grant: grammar subschemas, host_requirements and privilege strings remain review surface, and review reads them where the schema does not police them."
}
