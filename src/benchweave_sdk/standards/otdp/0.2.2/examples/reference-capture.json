{
  "otdp_version": "0.2.2",
  "descriptor_version": "1.0.0",
  "id": "dev.local.reference-capture",
  "display_name": "Illustrative reference-capture",
  "description": "Reference protocol only; not a qualified commercial instrument or bench safety profile.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "OTDP Reference",
    "model": "reference-capture",
    "firmware_policy": "listed",
    "supported_firmware": [
      "1.0"
    ]
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "reference_capture:create_plugin",
      "api_version": "1.1",
      "version": "1.0.0",
      "dependencies": [],
      "permissions": [
        "scoped_transport",
        "artifact_writer"
      ]
    }
  },
  "transport": {
    "type": "serial",
    "connection_key": "capture_device",
    "settings": {
      "baud": 115200,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "rtscts": false,
      "max_frame_bytes": 65536
    }
  },
  "capabilities": [
    "identify",
    "read",
    "capture"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "capture": {
      "timeout_ms": 10000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "voltage",
      "description": "voltage",
      "type": "float",
      "access": "ro",
      "semantic": "measurement",
      "binding": {
        "kind": "adapter",
        "key": "voltage_mv"
      },
      "unit": "V",
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    }
  ],
  "required_features": [
    "otdp.core/0.1.0",
    "otdp.adapter/0.1.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "OTDP reference protocol",
        "reference": "reference-protocols.md",
        "revision": "0.1.0"
      }
    ],
    "test_vectors": [
      {
        "id": "reference-capture-reference",
        "path": "reference-vectors.json",
        "purpose": "Normative reference exchanges and codec outcomes"
      }
    ]
  },
  "capture_formats": [
    "waveform_f64le"
  ],
  "capture_limits": {
    "max_samples": 1024,
    "max_bytes": 8192
  }
}
