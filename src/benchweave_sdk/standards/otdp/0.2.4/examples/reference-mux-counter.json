{
  "otdp_version": "0.2.4",
  "descriptor_version": "1.0.0",
  "id": "dev.local.reference-mux-counter",
  "display_name": "Illustrative reference-mux-counter",
  "description": "Reference protocol only; not a qualified commercial instrument or bench safety profile.",
  "identity": {
    "strategy": "adapter",
    "manufacturer": "OTDP Reference",
    "model": "reference-mux-counter",
    "firmware_policy": "listed",
    "supported_firmware": [
      "1.0"
    ]
  },
  "integration": {
    "mode": "adapter",
    "adapter": {
      "entry_point": "reference_mux_counter:create_plugin",
      "api_version": "1.1",
      "version": "1.0.0",
      "dependencies": [],
      "permissions": [
        "scoped_transport"
      ]
    }
  },
  "transport": {
    "type": "serial",
    "connection_key": "mux_counter",
    "settings": {
      "baud": 115200,
      "data_bits": 8,
      "parity": "none",
      "stop_bits": 1,
      "rtscts": false,
      "max_frame_bytes": 65536
    }
  },
  "capabilities": [
    "identify",
    "invoke",
    "read"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "invoke": {
      "timeout_ms": 30000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 2500,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": true,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "mux_count_a",
      "description": "Counter channel A. The read switches the counter multiplexer to channel A first — a device side effect declared per parameter (S20).",
      "type": "int",
      "access": "ro",
      "semantic": "measurement",
      "binding": {
        "kind": "adapter",
        "key": "mux_count_a"
      },
      "unit": "1",
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false,
        "side_effect": "state_change"
      }
    },
    {
      "name": "mux_count_b",
      "description": "Counter channel B. The read switches the counter multiplexer to channel B first — a device side effect declared per parameter (S20).",
      "type": "int",
      "access": "ro",
      "semantic": "measurement",
      "binding": {
        "kind": "adapter",
        "key": "mux_count_b"
      },
      "unit": "1",
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false,
        "side_effect": "state_change"
      }
    },
    {
      "name": "supply_v",
      "description": "Instrument supply voltage; a clean observation with no protocol side effect.",
      "type": "float",
      "access": "ro",
      "semantic": "measurement",
      "binding": {
        "kind": "adapter",
        "key": "supply_mv"
      },
      "unit": "V",
      "read_policy": {
        "max_age_ms": 250,
        "destructive": false
      }
    }
  ],
  "required_features": [
    "otdp.core/0.1.0",
    "otdp.adapter/0.1.0",
    "otdp.profile_actions/0.1.0",
    "otdp.measurement/0.1.0",
    "otdp.embedded_controller/1.0.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "OTDP reference protocol",
        "reference": "reference-protocols.md",
        "revision": "0.1.0"
      }
    ],
    "test_vectors": [
      {
        "id": "reference-mux-counter-reference",
        "path": "reference-vectors.json",
        "purpose": "Normative reference exchanges and codec outcomes"
      }
    ]
  },
  "channels": [
    {
      "id": "ch1",
      "label": "Multiplexed counter channel",
      "role": "measure",
      "quantities": [
        "frequency"
      ],
      "parameter_names": [
        "mux_count_a",
        "mux_count_b"
      ]
    },
    {
      "id": "ch2",
      "label": "Supply monitor",
      "role": "measure",
      "quantities": [
        "voltage"
      ],
      "parameter_names": [
        "supply_v"
      ]
    }
  ],
  "profiles": [
    "otdp.embedded_controller/1.0.0"
  ],
  "contracts": [
    {
      "id": "urn:otdp:profile-catalog:0.2.4",
      "path": "device-profile-catalog.json",
      "sha256": "89214042bee95b752ac252f088a703e43e86c202fc7146c222cf5091244d0d4c"
    },
    {
      "id": "urn:otdp:measurement:0.2.4",
      "path": "otdp-measurement.schema.json",
      "sha256": "2f7da116b07db4ba06eb72c6d16a5a8d5b13c6a34fe1f6ab01c99fce6a146063"
    }
  ],
  "actions": {
    "otdp.embedded_controller.telemetry/1.0.0": {
      "binding": {
        "kind": "adapter",
        "key": "otdp.embedded_controller.telemetry/1.0.0"
      },
      "input_constraints": {},
      "timeout_ms": 30000,
      "side_effect": "none",
      "cancellable": true,
      "retry": "never"
    },
    "otdp.embedded_controller.set_control/1.0.0": {
      "binding": {
        "kind": "adapter",
        "key": "otdp.embedded_controller.set_control/1.0.0"
      },
      "input_constraints": {},
      "timeout_ms": 30000,
      "side_effect": "state_change",
      "cancellable": true,
      "retry": "never"
    }
  }
}
