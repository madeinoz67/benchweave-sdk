{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:otdp:measurement:0.3.0",
  "title": "OTDP typed measurements and datasets 0.3.0",
  "description": "Read measurement-model.md. Shapes, dimensions, dtype encodings, required profile quantities and referenced artifacts require semantic checks. Unknown uncertainty is not zero.",
  "$defs": {
    "uncertainty": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown",
            "not_applicable"
          ]
        },
        "absolute": {
          "type": "number",
          "minimum": 0
        },
        "coverage_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "known"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "absolute"
            ]
          }
        }
      ]
    },
    "calibration": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "applied",
            "not_applied",
            "unknown"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "performed_at": {
          "type": "string",
          "format": "date-time"
        },
        "due_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "applied"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reference",
              "method"
            ]
          }
        }
      ]
    },
    "clock": {
      "type": "object",
      "properties": {
        "domain_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp_source": {
          "enum": [
            "device",
            "host",
            "unknown"
          ]
        },
        "synchronisation": {
          "enum": [
            "synchronised",
            "unsynchronised",
            "unknown"
          ]
        },
        "uncertainty_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "domain_id",
        "timestamp_source",
        "synchronisation",
        "uncertainty_s"
      ],
      "additionalProperties": false
    },
    "logReference": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "impedance_ohm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "enum": [
            "f64le",
            "i64le",
            "u64le",
            "u8",
            "bool_u8",
            "logic_u8",
            "complex_f64le",
            "utf8_json"
          ]
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "artifact_id",
        "encoding",
        "byte_length",
        "sha256"
      ],
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "channel_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "dtype": {
          "enum": [
            "float64",
            "int64",
            "uint64",
            "uint8",
            "bool",
            "logic",
            "string",
            "complex128"
          ]
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "values": {
          "type": "array",
          "items": {},
          "minItems": 0
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "calibration": {
          "$ref": "#/$defs/calibration"
        },
        "resolution": {
          "type": "number",
          "minimum": 0
        },
        "log_reference": {
          "$ref": "#/$defs/logReference"
        },
        "port_pair": {
          "type": "object",
          "properties": {
            "response": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "stimulus": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "response",
            "stimulus"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "valid",
            "partial",
            "invalid"
          ]
        },
        "status_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "quantity",
        "unit",
        "channel_ids",
        "dtype",
        "dimensions",
        "uncertainty",
        "calibration",
        "status"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "values"
          ],
          "not": {
            "required": [
              "artifact"
            ]
          }
        },
        {
          "required": [
            "artifact"
          ],
          "not": {
            "required": [
              "values"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "dtype": {
                "const": "float64"
              }
            },
            "required": [
              "dtype"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "minItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dtype": {
                "const": "int64"
              }
            },
            "required": [
              "dtype"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^-?(0|[1-9][0-9]*)$"
                },
                "minItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dtype": {
                "const": "uint64"
              }
            },
            "required": [
              "dtype"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "minItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dtype": {
                "const": "uint8"
              }
            },
            "required": [
              "dtype"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dtype": {
                "const": "bool"
              }
            },
            "required": [
              "dtype"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "minItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dtype": {
                "const": "logic"
              }
            },
            "required": [
              "dtype"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "enum": [
                    "0",
                    "1",
                    "x",
                    "z",
                    null
                  ]
                },
                "minItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dtype": {
                "const": "string"
              }
            },
            "required": [
              "dtype"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "minItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dtype": {
                "const": "complex128"
              }
            },
            "required": [
              "dtype"
            ]
          },
          "then": {
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "number"
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "minItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "partial",
                  "invalid"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "status_reason"
            ]
          }
        }
      ]
    },
    "axis": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "quantity": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "coordinates": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "regular"
                },
                "start": {
                  "type": "number"
                },
                "step": {
                  "type": "number"
                }
              },
              "required": [
                "kind",
                "start",
                "step"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "explicit"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "kind",
                "values"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "quantity",
        "unit",
        "length",
        "coordinates"
      ],
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "scalar_set",
            "waveform",
            "digital_trace",
            "spectrum",
            "iq",
            "table",
            "event_log",
            "network_parameters",
            "image"
          ]
        },
        "configuration_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "acquisition_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "clock": {
          "$ref": "#/$defs/clock"
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis"
          },
          "minItems": 0
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "minItems": 1
        },
        "trigger": {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "immediate",
                "software",
                "external",
                "edge",
                "unknown"
              ]
            },
            "time_relative_s": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "source",
            "time_relative_s"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "status_reason": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object"
        }
      },
      "required": [
        "dataset_id",
        "kind",
        "configuration_id",
        "acquisition_id",
        "started_at",
        "clock",
        "axes",
        "variables",
        "trigger",
        "status",
        "context"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "status_reason"
            ]
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/dataset"
}
