{
  "otdp_version": "0.1.0",
  "descriptor_version": "1.0.0",
  "id": "dev.local.reference-psu",
  "display_name": "Illustrative reference-psu",
  "description": "Reference protocol only; not a qualified commercial instrument or bench safety profile.",
  "identity": {
    "strategy": "scpi_idn",
    "manufacturer": "OTDP Reference",
    "model": "reference-psu",
    "firmware_policy": "listed",
    "supported_firmware": [
      "1.0"
    ]
  },
  "integration": {
    "mode": "declarative"
  },
  "transport": {
    "type": "lan_scpi",
    "connection_key": "psu",
    "settings": {
      "protocol": "raw",
      "port": 5555,
      "write_termination": "lf",
      "read_termination": "lf",
      "max_response_bytes": 4096
    }
  },
  "capabilities": [
    "identify",
    "read",
    "write",
    "self_test",
    "get_errors"
  ],
  "operations": {
    "identify": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "read": {
      "timeout_ms": 2000,
      "side_effect": "none",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "write": {
      "timeout_ms": 2000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": false,
      "completion": "readback"
    },
    "self_test": {
      "timeout_ms": 2000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    },
    "get_errors": {
      "timeout_ms": 2000,
      "side_effect": "state_change",
      "retry": "never",
      "cancellable": false,
      "completion": "acknowledged"
    }
  },
  "parameters": [
    {
      "name": "voltage_setpoint",
      "description": "voltage setpoint",
      "type": "float",
      "access": "rw",
      "semantic": "setpoint",
      "binding": {
        "kind": "scpi",
        "get": "VOLT?",
        "set": "VOLT {value}",
        "codec": {
          "kind": "float"
        }
      },
      "unit": "V",
      "range": [
        0,
        10
      ],
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      },
      "hazard_class": "unknown",
      "write_policy": {
        "effect": "setting",
        "completion": "readback",
        "retry": "never",
        "verification_parameter": "voltage_setpoint",
        "absolute_tolerance": 0.001,
        "settling_timeout_ms": 1000
      }
    },
    {
      "name": "voltage_measured",
      "description": "voltage measured",
      "type": "float",
      "access": "ro",
      "semantic": "measurement",
      "binding": {
        "kind": "scpi",
        "get": "MEAS:VOLT?",
        "codec": {
          "kind": "float"
        }
      },
      "unit": "V",
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      }
    },
    {
      "name": "output_enabled",
      "description": "output enabled",
      "type": "bool",
      "access": "rw",
      "semantic": "state",
      "binding": {
        "kind": "scpi",
        "get": "OUTP?",
        "set": "OUTP {value}",
        "codec": {
          "kind": "bool",
          "true_value": "1",
          "false_value": "0"
        }
      },
      "read_policy": {
        "max_age_ms": 0,
        "destructive": false
      },
      "hazard_class": "unknown",
      "write_policy": {
        "effect": "energise",
        "completion": "readback",
        "retry": "never",
        "verification_parameter": "output_enabled",
        "settling_timeout_ms": 1000
      }
    }
  ],
  "required_features": [
    "otdp.core/0.1.0"
  ],
  "provenance": {
    "sources": [
      {
        "title": "OTDP reference protocol",
        "reference": "reference-protocols.md",
        "revision": "0.3.0"
      }
    ],
    "test_vectors": [
      {
        "id": "reference-psu-reference",
        "path": "reference-vectors.json",
        "purpose": "Normative reference exchanges and codec outcomes"
      }
    ]
  },
  "diagnostics": {
    "self_test": {
      "command": "*TST?",
      "pass_response": "0"
    },
    "errors": {
      "command": "SYST:ERR?",
      "no_error_code": 0,
      "max_entries": 16
    }
  }
}
