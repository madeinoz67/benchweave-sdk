{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stg:interface:1.1.0",
  "$defs": {
    "ref": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_request",
            "unauthenticated",
            "forbidden",
            "not_found",
            "conflict",
            "policy_denied",
            "not_ready",
            "gone",
            "cursor_expired",
            "event_gap",
            "payload_too_large",
            "rate_limited",
            "unavailable",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "retry": {
          "enum": [
            "never",
            "read",
            "same_request"
          ]
        },
        "details": {
          "type": "object",
          "properties": {
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "field",
                  "reason"
                ],
                "additionalProperties": false
              }
            },
            "current_revision": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "stream_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "oldest_sequence": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "current_sequence": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "retry_after_ms": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "findings",
            "current_revision",
            "stream_id",
            "oldest_sequence",
            "current_sequence",
            "retry_after_ms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "message",
        "correlation_id",
        "retry",
        "details"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    },
    "bench": {
      "type": "object",
      "properties": {
        "bench_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "qualification": {
          "enum": [
            "none",
            "observation",
            "supervised",
            "unattended"
          ]
        },
        "tripped": {
          "type": "boolean"
        },
        "busy": {
          "type": "boolean"
        },
        "configuration": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "bench_id",
        "generation",
        "qualification",
        "tripped",
        "busy",
        "configuration"
      ],
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "descriptor": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        },
        "identity_state": {
          "enum": [
            "matched",
            "mismatch",
            "unknown"
          ]
        }
      },
      "required": [
        "device_id",
        "generation",
        "profiles",
        "descriptor",
        "identity_state"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "bench_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "accepted",
            "running",
            "protecting",
            "terminal"
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "passed",
                "assertion_failed",
                "cancelled",
                "timed_out",
                "tripped",
                "execution_error",
                "outcome_unknown",
                "interrupted"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "safe_state": {
          "anyOf": [
            {
              "enum": [
                "verified",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "terminal_record": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "version",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run_id",
        "bench_id",
        "revision",
        "state",
        "outcome",
        "safe_state",
        "terminal_record"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "terminal"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "string"
              },
              "safe_state": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "outcome": {
                "type": "null"
              },
              "safe_state": {
                "type": "null"
              },
              "terminal_record": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "safe_state": {
                "const": "verified"
              },
              "terminal_record": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "version",
                  "sha256"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "safe_state": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "outcome_unknown",
                  "interrupted"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "terminal"
              },
              "terminal_record": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "outcome_unknown",
                  "interrupted"
                ]
              }
            }
          }
        }
      ]
    },
    "lease": {
      "type": "object",
      "properties": {
        "lease_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "bench_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "active",
            "released",
            "expired"
          ]
        }
      },
      "required": [
        "lease_id",
        "bench_id",
        "sequence",
        "expires_at",
        "state"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "change_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "bench_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "enum": [
            "proposed",
            "applied",
            "failed",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "change_id",
        "bench_id",
        "generation",
        "state",
        "reasons"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "stream_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "run_changed",
            "lease_changed",
            "bench_changed",
            "trip",
            "authority_changed",
            "registry_status_changed",
            "evidence_gap"
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "stream_id",
        "sequence",
        "at",
        "kind",
        "run_id",
        "evidence"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_json_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_chunk_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_lease_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "min_poll_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_admission_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_json_bytes",
        "max_page_size",
        "max_chunk_bytes",
        "max_lease_ms",
        "min_poll_ms",
        "max_admission_ms"
      ],
      "additionalProperties": false
    },
    "gateway_info_input": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "gateway_info_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "gateway_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]*$"
                },
                "interface_version": {
                  "const": "0.1.0"
                },
                "mcp_version": {
                  "const": "2026-07-28"
                },
                "limits": {
                  "$ref": "#/$defs/limits"
                }
              },
              "required": [
                "gateway_id",
                "interface_version",
                "mcp_version",
                "limits"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "bench_list_input": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "limit",
        "cursor"
      ],
      "additionalProperties": false
    },
    "bench_list_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/bench"
                  }
                },
                "next_cursor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "items",
                "next_cursor"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "bench_get_input": {
      "type": "object",
      "properties": {
        "bench_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      },
      "required": [
        "bench_id"
      ],
      "additionalProperties": false
    },
    "bench_get_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "data": {
              "$ref": "#/$defs/bench"
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "device_list_input": {
      "type": "object",
      "properties": {
        "bench_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bench_id",
        "limit",
        "cursor"
      ],
      "additionalProperties": false
    },
    "device_list_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/device"
                  }
                },
                "next_cursor": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "items",
                "next_cursor"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "device_get_input": {
      "type": "object",
      "properties": {
        "bench_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      },
      "required": [
        "bench_id",
        "device_id"
      ],
      "additionalProperties": false
    },
    "device_get_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "data": {
              "$ref": "#/$defs/device"
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "document_get_input": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "sha256"
      ],
      "additionalProperties": false
    },
    "document_get_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "document": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "id",
                    "version",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "schema_id": {
                  "type": "string",
                  "minLength": 1
                },
                "content": {
                  "type": "object"
                },
                "original_utf8_base64": {
                  "type": "string",
                  "contentEncoding": "base64"
                }
              },
              "required": [
                "document",
                "schema_id",
                "content",
                "original_utf8_base64"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "run_check_input": {
      "type": "object",
      "properties": {
        "bench_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "binding_ref": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "bench_id",
        "binding_ref"
      ],
      "additionalProperties": false
    },
    "run_check_output": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "valid": {
                  "type": "boolean"
                },
                "generation": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "field",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "valid",
                "generation",
                "findings"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false
