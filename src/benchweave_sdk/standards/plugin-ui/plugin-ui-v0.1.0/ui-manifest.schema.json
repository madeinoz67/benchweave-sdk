{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchweave.dev/contracts/plugin-ui/0.1.0/ui-manifest.schema.json",
  "title": "BenchWeave plugin presentation manifest 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "plugin_id", "descriptor_sha256", "pages", "bindings"],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "plugin_id": {"$ref": "#/$defs/id"},
    "descriptor_sha256": {"$ref": "#/$defs/hash"},
    "pages": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/page"}},
    "bindings": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/binding"}},
    "assets": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/asset"}},
    "required_ui_features": {"$ref": "#/$defs/ids"},
    "extensions": {"type": "object", "maxProperties": 64, "patternProperties": {"^[a-z][a-z0-9.-]+:[a-z][a-z0-9._-]+$": {}}, "additionalProperties": false}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64},
    "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
    "ids": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "target_id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["configuration", "procedure", "observation", "dataset"]}, "target_id": {"$ref": "#/$defs/id"}, "preset_ids": {"$ref": "#/$defs/ids"}},
      "allOf": [{"if": {"properties": {"kind": {"const": "configuration"}}}, "else": {"not": {"required": ["preset_ids"]}}}]
    },
    "plot": {"type": "object", "additionalProperties": false, "required": ["kind", "binding_id", "x", "y"], "properties": {"kind": {"enum": ["time_series", "waveform"]}, "binding_id": {"$ref": "#/$defs/id"}, "x": {"$ref": "#/$defs/id"}, "y": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "kind", "bindings", "required"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/title"}, "kind": {"enum": ["configuration", "readings", "dataset", "class_panel", "custom_panel"]}, "bindings": {"$ref": "#/$defs/ids"}, "required": {"type": "boolean"}, "panel_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[0-9]+\\.[0-9]+\\.[0-9]+$"}, "plots": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/plot"}}},
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["class_panel", "custom_panel"]}}}, "then": {"required": ["panel_id"]}, "else": {"not": {"required": ["panel_id"]}}},
        {"if": {"properties": {"kind": {"enum": ["readings", "dataset"]}}}, "else": {"not": {"required": ["plots"]}}}
      ]
    },
    "envelope": {"type": "object", "additionalProperties": false, "required": ["contract_version", "descriptor_sha256", "resource_root", "manifest"], "properties": {"contract_version": {"const": "0.1.0"}, "descriptor_sha256": {"$ref": "#/$defs/hash"}, "resource_root": {"$ref": "#/$defs/path"}, "manifest": {"$ref": "#/$defs/reference"}}},
    "preset": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "id", "title", "revision", "plugin_id", "profile_ids", "supported_firmware", "settings_schema", "settings", "provenance"],
      "properties": {
        "contract_version": {"const": "0.1.0"}, "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/title"}, "revision": {"$ref": "#/$defs/id"}, "plugin_id": {"$ref": "#/$defs/id"}, "profile_ids": {"$ref": "#/$defs/ids"},
        "supported_firmware": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "settings_schema": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/hash"}}},
        "settings": {"type": "object"},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["author", "revision", "evidence"], "properties": {"author": {"$ref": "#/$defs/title"}, "revision": {"$ref": "#/$defs/id"}, "evidence": {"enum": ["synthetic", "documented"]}}}
      }
    },
    "variable": {"type": "object", "additionalProperties": false, "required": ["id", "type", "unit", "shape"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["number", "integer", "string", "boolean"]}, "unit": {"type": ["string", "null"], "maxLength": 64}, "shape": {"enum": ["scalar", "vector"]}, "axis_role": {"enum": ["receipt_time", "x", "y", "value"]}}},
    "variables": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/variable"}},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["observation", "configuration", "procedure", "dataset"]}, "parameter_id": {"$ref": "#/$defs/id"}, "channel_id": {"$ref": "#/$defs/id"}, "variables": {"$ref": "#/$defs/variables"}, "action_id": {"$ref": "#/$defs/id"}, "profile_ids": {"$ref": "#/$defs/ids"}, "input_schema_id": {"$ref": "#/$defs/id"}, "measurement_schema_id": {"$ref": "#/$defs/id"}, "schema_asset_id": {"$ref": "#/$defs/id"}, "preset_asset_ids": {"$ref": "#/$defs/ids"}},
      "oneOf": [
        {"properties": {"kind": {"const": "observation"}}, "required": ["parameter_id", "variables"], "not": {"anyOf": [{"required": ["action_id"]}, {"required": ["profile_ids"]}, {"required": ["input_schema_id"]}, {"required": ["measurement_schema_id"]}, {"required": ["schema_asset_id"]}, {"required": ["preset_asset_ids"]}]}},
        {"properties": {"kind": {"const": "configuration"}}, "required": ["action_id", "profile_ids", "input_schema_id", "schema_asset_id", "preset_asset_ids"], "not": {"anyOf": [{"required": ["parameter_id"]}, {"required": ["channel_id"]}, {"required": ["variables"]}, {"required": ["measurement_schema_id"]}]}},
        {"properties": {"kind": {"const": "procedure"}}, "required": ["action_id", "profile_ids", "input_schema_id"], "not": {"anyOf": [{"required": ["parameter_id"]}, {"required": ["channel_id"]}, {"required": ["variables"]}, {"required": ["measurement_schema_id"]}, {"required": ["schema_asset_id"]}, {"required": ["preset_asset_ids"]}]}},
        {"properties": {"kind": {"const": "dataset"}}, "required": ["action_id", "profile_ids", "measurement_schema_id", "variables"], "not": {"anyOf": [{"required": ["parameter_id"]}, {"required": ["channel_id"]}, {"required": ["input_schema_id"]}, {"required": ["schema_asset_id"]}, {"required": ["preset_asset_ids"]}]}}
      ]
    },
    "catalogue": {"type": "object", "additionalProperties": false, "required": ["contract_version", "descriptor_sha256", "targets"], "properties": {"contract_version": {"const": "0.1.0"}, "descriptor_sha256": {"$ref": "#/$defs/hash"}, "targets": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/target"}}}}
  }
}
