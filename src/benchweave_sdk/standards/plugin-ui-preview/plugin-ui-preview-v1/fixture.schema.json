{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchweave.dev/contracts/plugin-ui-preview/1/fixture.schema.json",
  "title": "BenchWeave plugin UI preview fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "id",
    "title",
    "description",
    "timestamp_strategy",
    "bindings",
    "permissions",
    "lease_state",
    "approval_state",
    "unavailable_panels",
    "expected_severity",
    "request_outcomes"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "timestamp_strategy": { "enum": ["fixed", "relative"] },
    "bindings": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/binding" }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["observer", "controller", "administrator"] }
    },
    "lease_state": { "enum": ["none", "available", "held", "held_by_other", "expired"] },
    "approval_state": { "enum": ["not_required", "pending", "approved", "rejected"] },
    "unavailable_panels": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/id" }
    },
    "expected_severity": {
      "enum": ["neutral", "success", "advisory", "warning", "critical", "trip"]
    },
    "request_outcomes": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/request_outcome" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "unit", "quality", "freshness_ms", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "value": { "type": ["boolean", "integer", "number", "string", "null"] },
        "unit": { "type": ["string", "null"], "maxLength": 32 },
        "quality": { "enum": ["simulated", "loading", "stale", "partial", "disconnected", "unknown"] },
        "freshness_ms": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400000 },
        "provenance": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "request_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "outcome", "message"],
      "properties": {
        "binding_id": { "$ref": "#/$defs/id" },
        "outcome": {
          "enum": [
            "accepted",
            "permission_rejected",
            "lease_rejected",
            "approval_required",
            "policy_rejected",
            "transport_failed",
            "device_rejected",
            "unknown_final_state"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    }
  }
}
