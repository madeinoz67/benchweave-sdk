{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "manual",
        "gateway_owned"
      ]
    },
    "safety_policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "required_profiles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "required_profiles",
          "channels"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "max_body_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "max_protection_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    }
  },
  "required": [
    "contract_version",
    "id",
    "version",
    "description",
    "mode",
    "safety_policy",
    "roles",
    "max_body_ms",
    "max_protection_ms",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "minItems": 0
        },
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "^\\$stg_"
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "type": "object",
          "properties": {
            "$stg_ref": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]*$"
                },
                "pointer": {
                  "type": "string",
                  "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                }
              },
              "required": [
                "step",
                "pointer"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "$stg_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$stg_channel": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            }
          },
          "required": [
            "$stg_channel"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "$stg_issue": {
              "enum": [
                "configuration_id",
                "acquisition_id"
              ]
            }
          },
          "required": [
            "$stg_issue"
          ],
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "kind": {
              "const": "invoke"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "action_id": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/value"
              }
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            }
          },
          "required": [
            "id",
            "kind",
            "role",
            "action_id",
            "input",
            "timeout_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "kind": {
              "const": "read"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "parameter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            }
          },
          "required": [
            "id",
            "kind",
            "role",
            "parameter",
            "timeout_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "kind": {
              "const": "write"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "parameter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "value": {
              "$ref": "#/$defs/value"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            }
          },
          "required": [
            "id",
            "kind",
            "role",
            "parameter",
            "value",
            "timeout_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "kind": {
              "const": "capture"
            },
            "role": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "format": {
              "enum": [
                "waveform_f64le",
                "raw_binary"
              ]
            },
            "sample_count": {
              "type": "integer",
              "minimum": 1
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400000
            }
          },
          "required": [
            "id",
            "kind",
            "role",
            "format",
            "sample_count",
            "max_bytes",
            "timeout_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "kind": {
              "const": "delay"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "id",
            "kind",
            "duration_ms"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "kind": {
              "const": "sample"
            },
            "source_step": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "variable_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "max_age_ms": {
              "type": "integer",
              "minimum": 1
            },
            "require_known_uncertainty": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "kind",
            "source_step",
            "variable_id",
            "unit",
            "max_age_ms",
            "require_known_uncertainty"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "kind": {
              "const": "assert"
            },
            "predicate": {
              "type": "object",
              "properties": {
                "sample": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]*$"
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              },
              "required": [
                "sample",
                "minimum",
                "maximum"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "kind",
            "predicate"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "kind": {
              "const": "if"
            },
            "predicate": {
              "type": "object",
              "properties": {
                "sample": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]*$"
                },
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              },
              "required": [
                "sample",
                "minimum",
                "maximum"
              ],
              "additionalProperties": false
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step"
              },
              "minItems": 1
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step"
              },
              "minItems": 0
            }
          },
          "required": [
            "id",
            "kind",
            "predicate",
            "then",
            "else"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "kind": {
              "const": "repeat"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step"
              },
              "minItems": 1
            }
          },
          "required": [
            "id",
            "kind",
            "count",
            "steps"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stg:execution:procedure:0.2.0",
  "title": "STG procedure contract",
  "description": "Structure only. Apply execution-contract.md semantic and qualification rules; JSON validity grants no authority."
}
