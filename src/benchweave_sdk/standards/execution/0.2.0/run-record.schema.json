{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "binding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "principal_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "body_outcome": {
      "enum": [
        "completed",
        "assertion_failed",
        "cancelled",
        "timed_out",
        "tripped",
        "execution_error",
        "outcome_unknown",
        "interrupted"
      ]
    },
    "outcome": {
      "enum": [
        "passed",
        "assertion_failed",
        "cancelled",
        "timed_out",
        "tripped",
        "execution_error",
        "outcome_unknown",
        "interrupted"
      ]
    },
    "safe_state": {
      "enum": [
        "verified",
        "unknown"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "binding",
    "principal_id",
    "started_at",
    "ended_at",
    "body_outcome",
    "outcome",
    "safe_state",
    "reasons",
    "evidence_refs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "body_outcome": {
            "const": "completed"
          },
          "safe_state": {
            "const": "verified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "safe_state": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "outcome_unknown",
              "interrupted"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "body_outcome": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "passed",
              "outcome_unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "body_outcome": {
            "const": "assertion_failed"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "assertion_failed",
              "outcome_unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "body_outcome": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "cancelled",
              "outcome_unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "body_outcome": {
            "const": "timed_out"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "timed_out",
              "outcome_unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "body_outcome": {
            "const": "tripped"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "tripped",
              "outcome_unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "body_outcome": {
            "const": "execution_error"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "execution_error",
              "outcome_unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "body_outcome": {
            "const": "outcome_unknown"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "outcome_unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "body_outcome": {
            "const": "interrupted"
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "enum": [
              "interrupted",
              "outcome_unknown"
            ]
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stg:execution:run-record:0.2.0",
  "title": "STG run-record contract",
  "description": "Structure only. Apply execution-contract.md semantic and qualification rules; JSON validity grants no authority."
}
