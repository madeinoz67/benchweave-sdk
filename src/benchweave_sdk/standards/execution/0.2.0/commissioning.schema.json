{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "bench": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "package_lock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "procedure_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "dut_class": {
      "enum": [
        "low_voltage_embedded",
        "mains_powered"
      ]
    },
    "modes": {
      "type": "array",
      "items": {
        "enum": [
          "observation",
          "supervised",
          "unattended"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "owners": {
      "type": "object",
      "properties": {
        "bench": {
          "type": "string",
          "minLength": 1
        },
        "test_safety": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "bench",
        "test_safety",
        "system"
      ],
      "additionalProperties": false
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "offline_status_max_age_ms": {
      "type": "integer",
      "minimum": 1
    },
    "scheduling_overhead_ms": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "enum": [
              "identity",
              "protocol",
              "envelope",
              "protection",
              "timing",
              "safe_transition",
              "audit_failure",
              "unattended"
            ]
          },
          "report": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          },
          "tested_at": {
            "type": "string",
            "format": "date-time"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "partial"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "category",
          "report",
          "tested_at",
          "scope",
          "result",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "contract_version",
    "id",
    "version",
    "description",
    "bench",
    "policy",
    "package_lock",
    "procedure_refs",
    "dut_class",
    "modes",
    "owners",
    "approved_by",
    "approved_at",
    "expires_at",
    "offline_status_max_age_ms",
    "scheduling_overhead_ms",
    "evidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stg:execution:commissioning:0.2.0",
  "title": "STG commissioning contract",
  "description": "Structure only. Apply execution-contract.md semantic and qualification rules; JSON validity grants no authority."
}
