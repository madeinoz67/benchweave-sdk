{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchweave.dev/contracts/plugin-ui-class-reference/0.4.0/class-reference.schema.json",
  "title": "BenchWeave plugin-ui-class-reference class reference 0.4.0",
  "description": "One reference presentation per device class, written as data. Structure, not data (D2): the reference authors structural strings and structural numbers only - page ids/titles, binding slot keys, the group pattern, group size 8. No values, units, thresholds or limits; everything data resolves at expansion from the descriptor and the OTDP action schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile_id",
    "title",
    "targets",
    "slots",
    "pages",
    "expect",
    "cannot_derive"
  ],
  "properties": {
    "contract_version": {
      "const": "0.4.0"
    },
    "profile_id": {
      "$ref": "#/$defs/profile_id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_ui"
      ],
      "properties": {
        "plugin_ui": {
          "type": "string",
          "pattern": "^>=?[0-9]+(\\.[0-9]+)*$",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "slots": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/slot"
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/page_template"
      }
    },
    "layouts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "https://benchweave.dev/contracts/plugin-ui-class-reference/0.4.0/layout.schema.json#/$defs/layout_page"
      }
    },
    "expect": {
      "$ref": "#/$defs/expect"
    },
    "cannot_derive": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/cannot_derive"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^otdp\\.[a-z_]+/[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "action_urn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^otdp\\.[a-z_]+\\.[a-z_]+/[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "slot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "channels"
            },
            "where_role": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "key": {
              "const": "id"
            },
            "label": {
              "const": "label"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "action"
          ],
          "properties": {
            "kind": {
              "enum": [
                "dataset",
                "configuration",
                "procedure"
              ]
            },
            "action": {
              "$ref": "#/$defs/action_urn"
            },
            "when_declared": {
              "type": "boolean"
            },
            "schema_source": {
              "enum": [
                "input_schema",
                "output_measurement"
              ]
            },
            "host_supplied": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "vendor_actions"
            }
          }
        }
      ]
    },
    "page_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "binding_slots"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "configuration",
            "readings",
            "dataset"
          ]
        },
        "binding_slots": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
          }
        },
        "vendor_features": {
          "type": "boolean"
        },
        "plot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "over_slot"
          ],
          "properties": {
            "kind": {
              "enum": [
                "digital_lanes",
                "time_series",
                "waveform"
              ]
            },
            "over_slot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "group_size": {
              "const": 8
            },
            "group_label_pattern": {
              "const": "D{first}-D{last}"
            },
            "group_radix": {
              "enum": [
                "hex",
                "decimal"
              ]
            },
            "series": {
              "const": "numeric_variables"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "digital_lanes"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "not": {
                  "required": [
                    "series"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "time_series"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "series"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "group_size"
                      ]
                    },
                    {
                      "required": [
                        "group_label_pattern"
                      ]
                    },
                    {
                      "required": [
                        "group_radix"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "waveform"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "required": [
                  "series"
                ],
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "group_size"
                      ]
                    },
                    {
                      "required": [
                        "group_label_pattern"
                      ]
                    },
                    {
                      "required": [
                        "group_radix"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "$ref": "#/$defs/component_expect"
          }
        },
        "controls": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "enum": [
              "button",
              "staging",
              "preset",
              "deviation"
            ]
          }
        },
        "forbid": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "component_expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": [
            "string",
            "integer"
          ]
        },
        "attribute": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": false,
          "properties": {
            "data-bw-lane-kind=channel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "data-bw-lane-kind=group": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "data-bw-lane-kind=decoder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "per_page": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "must_not_be_wrapped_by": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "cannot_derive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "aspect",
        "reason",
        "author_action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "aspect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "author_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
