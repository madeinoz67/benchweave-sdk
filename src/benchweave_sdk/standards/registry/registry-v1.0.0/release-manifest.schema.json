{
  "type": "object",
  "properties": {
    "manifest_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "kind": {
      "enum": [
        "profile",
        "descriptor",
        "implementation"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "publisher_id": {
      "type": "string",
      "minLength": 1
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "contact"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "support_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "issues_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "licence": {
      "type": "object",
      "properties": {
        "spdx_expression": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        }
      },
      "required": [
        "spdx_expression",
        "file"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "revision"
      ],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "otdp_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "adapter_api_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "stg_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "runtimes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "os": {
                "type": "string",
                "minLength": 1
              },
              "architecture": {
                "type": "string",
                "minLength": 1
              },
              "python_version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "os",
              "architecture",
              "python_version"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "host_provider_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "otdp_versions",
        "adapter_api_versions",
        "stg_versions",
        "runtimes",
        "host_provider_ids"
      ],
      "additionalProperties": false
    },
    "device_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "manufacturer": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "firmware": {
            "type": "object",
            "properties": {
              "policy": {
                "enum": [
                  "listed",
                  "commissioning_required"
                ]
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": [
              "policy",
              "versions"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "policy": {
                      "const": "listed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "versions": {
                      "minItems": 1
                    }
                  }
                },
                "else": {
                  "properties": {
                    "versions": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          },
          "transports": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "profile_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "descriptor_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "manufacturer",
          "model",
          "aliases",
          "firmware",
          "transports",
          "profile_ids",
          "descriptor_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "provides": {
      "type": "object",
      "properties": {
        "profile_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "descriptor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "profile_ids",
        "descriptor_ids"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "registry_id": {
            "type": "string",
            "minLength": 1
          },
          "package_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "registry_id",
          "package_id",
          "version",
          "manifest_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "payload": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_type": {
          "enum": [
            "application/zip",
            "application/gzip"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              "role": {
                "enum": [
                  "profile",
                  "descriptor",
                  "implementation",
                  "schema",
                  "test",
                  "documentation",
                  "licence",
                  "sbom",
                  "build_provenance",
                  "dependency_lock"
                ]
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "role",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "sha256",
        "bytes",
        "media_type",
        "files"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "enum": [
              "structural",
              "simulated",
              "hardware"
            ]
          },
          "report_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          },
          "tested_at": {
            "type": "string",
            "format": "date-time"
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "partial"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "level",
          "report_path",
          "tested_at",
          "target",
          "result",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "changelog_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "migration_notes_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "upstream": {
      "type": "object",
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "registry_id",
        "package_id",
        "version",
        "manifest_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "manifest_version",
    "registry_id",
    "package_id",
    "version",
    "kind",
    "display_name",
    "summary",
    "released_at",
    "tags",
    "publisher_id",
    "maintainers",
    "support_url",
    "issues_url",
    "licence",
    "source",
    "compatibility",
    "device_targets",
    "provides",
    "dependencies",
    "permissions",
    "payload",
    "evidence",
    "changelog_path",
    "migration_notes_path",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "profile"
          }
        }
      },
      "then": {
        "properties": {
          "device_targets": {
            "maxItems": 0
          },
          "provides": {
            "properties": {
              "profile_ids": {
                "minItems": 1
              },
              "descriptor_ids": {
                "maxItems": 0
              }
            }
          },
          "payload": {
            "properties": {
              "files": {
                "items": {
                  "properties": {
                    "role": {
                      "not": {
                        "enum": [
                          "implementation",
                          "descriptor"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "device_targets": {
            "minItems": 1
          },
          "provides": {
            "properties": {
              "descriptor_ids": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "implementation"
          }
        }
      },
      "then": {
        "properties": {
          "compatibility": {
            "properties": {
              "adapter_api_versions": {
                "minItems": 1
              },
              "runtimes": {
                "minItems": 1
              }
            }
          },
          "payload": {
            "properties": {
              "files": {
                "allOf": [
                  {
                    "contains": {
                      "properties": {
                        "role": {
                          "const": "implementation"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "role": {
                          "const": "sbom"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "role": {
                          "const": "build_provenance"
                        }
                      }
                    }
                  },
                  {
                    "contains": {
                      "properties": {
                        "role": {
                          "const": "dependency_lock"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "payload": {
            "properties": {
              "files": {
                "items": {
                  "properties": {
                    "role": {
                      "not": {
                        "const": "implementation"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stg:registry:release-manifest:1.0.0",
  "title": "STG registry release-manifest",
  "description": "Read registry-specification.md for admission, cross-field, authenticity and lifecycle requirements. Structural validity does not establish trust."
}
