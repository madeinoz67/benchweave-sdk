{
  "type": "object",
  "properties": {
    "status_version": {
      "const": "0.1.0"
    },
    "release": {
      "type": "object",
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "registry_id",
        "package_id",
        "version",
        "manifest_sha256"
      ],
      "additionalProperties": false
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle": {
      "enum": [
        "published",
        "deprecated",
        "yanked",
        "revoked"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "support_state": {
      "enum": [
        "maintained",
        "maintenance_only",
        "unmaintained"
      ]
    },
    "support_contact": {
      "type": "string",
      "minLength": 1
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "unreviewed",
              "changes_requested",
              "accepted"
            ]
          },
          "report_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "reviewer_id",
          "decision",
          "report_sha256",
          "reviewed_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "advisories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "required": [
          "id",
          "severity",
          "summary",
          "url"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "replacement": {
      "type": "object",
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "package_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "registry_id",
        "package_id",
        "version",
        "manifest_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status_version",
    "release",
    "sequence",
    "updated_at",
    "expires_at",
    "lifecycle",
    "reason",
    "support_state",
    "support_contact",
    "reviews",
    "advisories"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stg:registry:release-status:1.0.0",
  "title": "STG registry release-status",
  "description": "Read registry-specification.md for admission, cross-field, authenticity and lifecycle requirements. Structural validity does not establish trust."
}
