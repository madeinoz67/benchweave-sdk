{
  "type": "object",
  "properties": {
    "lock_version": {
      "const": "0.1.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "registry_id": {
            "type": "string",
            "minLength": 1
          },
          "package_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "registry_id",
          "package_id",
          "version",
          "manifest_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "registry_id": {
            "type": "string",
            "minLength": 1
          },
          "package_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "registry_id",
          "package_id",
          "version",
          "manifest_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "approval": {
      "type": "object",
      "properties": {
        "principal_id": {
          "type": "string",
          "minLength": 1
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "principal_id",
        "approved_at",
        "policy_id",
        "policy_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "lock_version",
    "created_at",
    "roots",
    "packages",
    "approval"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stg:registry:package-lock:1.0.0",
  "title": "STG registry package-lock",
  "description": "Read registry-specification.md for admission, cross-field, authenticity and lifecycle requirements. Structural validity does not establish trust."
}
