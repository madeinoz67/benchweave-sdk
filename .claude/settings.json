{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Project-owned guards (see .claude/memory-protocol.md for the protocol and its measured history).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/drift-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ledger-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/codanna-reindex.ts\""
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/codanna-nudge.ts\""
          }
        ]
      },
      {
        "matcher": "mcp__codanna__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/codanna-nudge.ts\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-drain.mjs\" --hook --trigger PreCompact --base http://127.0.0.1:8125/mcp"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-drain.mjs\" --hook --trigger SessionEnd --base http://127.0.0.1:8125/mcp"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-drain.mjs\" --hook --trigger Stop --debounce 20 --base http://127.0.0.1:8125/mcp"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-freshness.mjs\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "codanna": {
      "source": {
        "source": "github",
        "repo": "bartolli/codanna"
      }
    }
  },
  "enabledPlugins": {
    "codanna-toolset@codanna": true
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(codanna mcp:*)",
      "Bash(codanna retrieve:*)",
      "Bash(codanna index:*)",
      "Bash(codanna init)",
      "Bash(codanna dump:*)",
      "Bash(rg:*)",
      "Bash(sed -n:*)",
      "mcp__codanna__analyze_impact",
      "mcp__codanna__find_callers",
      "mcp__codanna__find_symbol",
      "mcp__codanna__get_calls",
      "mcp__codanna__get_index_info",
      "mcp__codanna__search_documents",
      "mcp__codanna__search_symbols",
      "mcp__codanna__semantic_search_docs",
      "mcp__codanna__semantic_search_with_context"
    ]
  }
}
